# Copy this file to .env and fill in your proxy's experimental_bearer_token.
OPENAI_API_KEY=

# LLM proxy configuration.
# All chat agents use these settings via create_llm() in backend/agent/multi_agent.py.
OPENAI_BASE_URL=https://share.transmd.cloud/v1
OPENAI_MODEL=gpt-6.1-sol
OPENAI_ACTOR_AUTHORIZATION=local-image-extension

# The ChatOpenAI client uses the Responses API with store=False.
# Codex settings such as wire_api, review_model and features are not read here.
# Handbook search uses local intfloat/multilingual-e5-small on CPU.
# No embeddings API key or endpoint is needed. First use downloads the model
# (about 471 MB of weights), cached under data/models/.

# PostgreSQL (local development defaults; host is localhost).
POSTGRES_USER=onboardai
POSTGRES_PASSWORD=onboardai
POSTGRES_DB=onboardai
DATABASE_URL=postgresql://onboardai:onboardai@localhost:5432/onboardai

# Docker Compose reads POSTGRES_* from this file and rewrites DATABASE_URL
# to use host `postgres` inside containers.

# pgAdmin UI at http://localhost:8080
PGADMIN_DEFAULT_EMAIL=admin@onboardai.com
PGADMIN_DEFAULT_PASSWORD=admin

# Optional evaluation report directory. Leave unset to use the project default.
# Docker Compose sets this to /app/evals/results for backend and evals.
# EVALS_RESULTS_DIR=

# Optional DeepEval settings (only needed when running DeepEval).
# DEEPEVAL_MODEL=gpt-4o-mini
# DEEPEVAL_THRESHOLD=0.7
