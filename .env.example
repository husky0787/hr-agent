# 聊天與文件閱讀版本：複製至 .env，再填入三組供應商的 Key。
# 此範本對應 docs/specs/chat-document-demo.md。
# 所有 Key 只供後端使用。同名變數只保留一份，避免下方空白值覆蓋。

# GPT：預設主服務，沿用之前的代理設定。
# 填入原本 GPT 代理的 Key，不是 xAI Key。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://share.transmd.cloud/v1
OPENAI_MODEL=gpt-6.1-sol
OPENAI_ACTOR_AUTHORIZATION=local-image-extension

# xAI：GPT 不可用時的備援。填入 xAI Console 建立的 Key。
# 如果現有 .env 把 xAI Key 放在 OPENAI_API_KEY，請先搬到此處。
# https://docs.x.ai/developers/quickstart
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3

# 聊天請求時間上限、輸出 token 上限及 GPT 故障後的冷卻秒數。
CHAT_TIMEOUT_SECONDS=30
CHAT_MAX_OUTPUT_TOKENS=1200
CHAT_FALLBACK_COOLDOWN_SECONDS=60

# Jina：文件與問題的 embedding API。填入 Jina Key，不是聊天供應商 Key。
# https://jina.ai/embeddings/
# jina-embeddings-v4 免費 API 適用於研究／非商業 Demo，有限流。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v4
EMBEDDING_DIMENSIONS=2048
EMBEDDING_TIMEOUT_SECONDS=60

# 本機預設使用專案 data/；容器持久磁碟掛載至 /app/data。
# DATA_DIR=/app/data
CORS_ORIGINS=http://localhost:5173

# 前端單獨部署時填入公開 HTTPS 後端網址；本機可沿用 Vite proxy。
# 前端不能放入任何供應商 Key。
VITE_API_URL=

# 聊天與文件閱讀版本不需要 DATABASE_URL、POSTGRES_* 或 PGADMIN_*。
# Codex 的 wire_api、review_model、features 等設定不由本專案讀取。
